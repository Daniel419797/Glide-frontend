# Server-only backend base URL. Never expose this as NEXT_PUBLIC_*.
GLIDE_API_URL=http://127.0.0.1:5000/api/v1

# Canonical browser origin used for mutation origin checks.
GLIDE_APP_URL=http://localhost:3000

# Integration and session policy.
GLIDE_REQUEST_TIMEOUT_MS=10000
GLIDE_SESSION_COOKIE=glide_refresh
GLIDE_SESSION_MAX_AGE_SECONDS=2592000
